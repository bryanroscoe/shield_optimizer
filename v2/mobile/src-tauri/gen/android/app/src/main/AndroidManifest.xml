<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Phone/tablet app only. It drives a TV over the network and is not
         itself a TV app, so it declares no leanback feature or TV launcher
         entry (Play would otherwise review and list it as a TV app).
         NEARBY_WIFI_DEVICES is not declared: NsdManager mDNS discovery
         needs only INTERNET and CHANGE_WIFI_MULTICAST_STATE.
         com.android.vending.BILLING is merged from the billing plugin. -->

    <!-- No Android backup or device transfer of app data (it holds the ADB key
         paired TVs trust). allowBackup="false" covers Android 11 and lower; on
         Android 12+ it no longer stops device transfer, so dataExtractionRules
         excludes everything from both. Play restores purchases itself. -->
    <application
        android:name=".App"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.atv_optimizer_mobile"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!-- fontScale and density keep a text or display size change from
             recreating the activity, which reloads the WebView and drops the
             session (and any apply in progress). MainActivity passes the new
             font scale on to the WebView. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|fontScale|density|fontWeightAdjustment"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Share's temporary read grants. file_paths.xml maps only cache/exports/. -->
        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
