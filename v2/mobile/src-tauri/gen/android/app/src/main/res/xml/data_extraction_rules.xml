<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31): nothing leaves the phone through Google backup or a
     device-to-device transfer. App data holds the ADB key every paired TV
     trusts, the reports install id and opt-out, the license and Play purchase
     records, saved TVs (WebView storage) and snapshots; none of it may be
     copied off the phone. Play restores a Pro purchase from the Google account
     on its own. Android 11 and lower: android:allowBackup="false". -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
