<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.bryanroscoe.ATVOptimizer</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary=https://github.com/bryanroscoe/shield_optimizer/blob/main/LICENSE</project_license>
  <name>ATV Optimizer</name>
  <summary>Debloat and tune Android TV devices</summary>
  <developer id="io.github.bryanroscoe">
    <name>Bryan Roscoe</name>
  </developer>
  <description>
    <p>
      Debloat and tune your Android TV from your computer. Disable bloat, switch launchers,
      sideload APKs, adjust HDMI-CEC and frame-rate matching, and check device health.
    </p>
    <p>
      Works on Nvidia Shield TV, Onn 4K Pro, Chromecast with Google TV, Google TV Streamer and
      other Android TV devices. ATV Optimizer finds TVs on your network and downloads its own
      copy of Google's adb tool on first launch.
    </p>
    <p>
      Packages the system needs are protected, and anything the app can't vouch for stays as it
      is until you decide otherwise. Snapshots save a setup so you can copy it to another TV.
    </p>
  </description>
  <launchable type="desktop-id">io.github.bryanroscoe.ATVOptimizer.desktop</launchable>
  <url type="homepage">https://github.com/bryanroscoe/shield_optimizer</url>
  <url type="bugtracker">https://github.com/bryanroscoe/shield_optimizer/issues</url>
  <url type="vcs-browser">https://github.com/bryanroscoe/shield_optimizer</url>
  <content_rating type="oars-1.1">
    <content_attribute id="social-info">mild</content_attribute>
  </content_rating>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <requires>
    <display_length compare="ge">720</display_length>
  </requires>
  <branding>
    <color type="primary" scheme_preference="light">#c9f24e</color>
    <color type="primary" scheme_preference="dark">#1b2129</color>
  </branding>
  <screenshots>
    <screenshot type="default">
      <caption>Devices found on your network</caption>
      <image>https://raw.githubusercontent.com/bryanroscoe/shield_optimizer/main/v2/flatpak/screenshots/devices.png</image>
    </screenshot>
    <screenshot>
      <caption>Choose what to disable, with the reason for each package</caption>
      <image>https://raw.githubusercontent.com/bryanroscoe/shield_optimizer/main/v2/flatpak/screenshots/optimize.png</image>
    </screenshot>
    <screenshot>
      <caption>Switch the home screen launcher</caption>
      <image>https://raw.githubusercontent.com/bryanroscoe/shield_optimizer/main/v2/flatpak/screenshots/launcher.png</image>
    </screenshot>
    <screenshot>
      <caption>Save a setup and copy it to another TV</caption>
      <image>https://raw.githubusercontent.com/bryanroscoe/shield_optimizer/main/v2/flatpak/screenshots/snapshots.png</image>
    </screenshot>
  </screenshots>
  <releases>
    <release version="2.5.0" date="2026-11-04">
      <url type="details">https://github.com/bryanroscoe/shield_optimizer/releases/tag/v2-2.5.0</url>
    </release>
  </releases>
</component>
