<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged into the generated Info.plist at bundle time. Tauri picks this file up
  automatically because it sits beside tauri.conf.json.

  The app touches a removable volume in exactly two places, both of which the
  user starts: choosing a folder of APKs on the Sideload tab, and saving a file
  pulled off the TV. macOS shows the string below when it asks, so the prompt
  explains itself instead of arriving unattributed (GitHub #89).

  macOS 15+ also asks before the app, or the adb server it starts, reaches
  anything on the local network; adb's traffic counts as the app's (Apple
  TN3179). NSLocalNetworkUsageDescription is the text in that alert.
  NSBonjourServices lists the service types adb browses for, as TN3179 asks of
  any app whose local network use involves browsing specific Bonjour services.
-->
<plist version="1.0">
  <dict>
    <key>NSRemovableVolumesUsageDescription</key>
    <string>ATV Optimizer reads a removable volume only when you pick a folder of APKs to sideload, or save a file you pulled off your TV. Declining does not affect anything else in the app.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>ATV Optimizer connects to your TV over your local network using ADB, to find it, read its apps and apply the changes you choose.</string>
    <key>NSBonjourServices</key>
    <array>
      <string>_googlecast._tcp</string>
      <string>_androidtvremote2._tcp</string>
      <string>_adb._tcp</string>
      <string>_adb-tls-connect._tcp</string>
      <string>_adb-tls-pairing._tcp</string>
    </array>
  </dict>
</plist>
