{
  "name": "atv-optimizer-telemetry-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cloudflare Worker + D1 backend for ATV Optimizer telemetry and the support-tier list.",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "migrate:local": "wrangler d1 migrations apply telemetry --local",
    "report": "node scripts/report.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.11",
    "@cloudflare/workers-types": "^5.20261031.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "4.156.0"
  }
}
